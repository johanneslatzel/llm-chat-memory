# LLM Chat Memory — Configuration (example reference)
# Copy to .env and fill in your values.

# Directory containing memory JSON files (default: './memories')
# LLM_CHAT_MEMORY_DIR=./memories

# Max memories to inject per message (default: 2)
# LLM_CHAT_MEMORY_MAX_INJECT_PER_MESSAGE=2

# Cumulative cap for the entire send-loop cycle (default: 5)
# LLM_CHAT_MEMORY_MAX_INJECT_PER_SEND_LOOP=5

# Character limit for the serialized JSON returned by get_memory (default: 500)
# LLM_CHAT_MEMORY_MAX_INJECTION_CONTENT_LENGTH=500

# Minimum cosine similarity for a memory to be considered relevant (default: 0.4)
# LLM_CHAT_MEMORY_SIMILARITY_GATE=0.4

# Hugging Face model ID for local embedding generation (default: 'Xenova/all-MiniLM-L6-v2')
# Pass config.embeddingModel to HuggingFaceEmbeddingProvider({ model }).
# LLM_CHAT_MEMORY_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Half-life in seconds for the recency score decay curve (default: 3600)
# LLM_CHAT_MEMORY_RECENCY_HALF_LIFE=3600

# Minimum summary length in characters (default: 50)
# LLM_CHAT_MEMORY_MIN_SUMMARY_LENGTH=50

# Base maximum summary length; effective maximum is max(this value, 20% of content length) (default: 600)
# LLM_CHAT_MEMORY_MAX_SUMMARY_LENGTH=600
